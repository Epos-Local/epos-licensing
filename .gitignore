# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# ad-hoc DB backups (scripts/backup-db.sh) — full customer/license data, never
# committed
/backups

# generated prisma client — rebuilt by `postinstall`, platform-specific engine
# binaries, not source
/generated

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# key material and issued licenses
# LICENSE_SIGNING_PRIVATE_KEY belongs in the Vercel/Supabase environment and
# nowhere else — anyone holding it can mint licenses every client will accept.
# These patterns are the backstop for a key written to disk while debugging, or
# a .lic generated by hand instead of through the panel's streaming download.
*.pem
*.key
*.p8
*.pfx
*.lic

# misc
.DS_Store
Thumbs.db
desktop.ini

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
# Ignore every variant and allow the template back in by name: the stock T3 rule
# only catches `.env` and `.env*.local`, so a `.env.production` holding the
# signing key and the Supabase password would have been committed silently.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# editor files
.idea
.vscode
*.code-workspace

# agent tooling
.claude/settings.local.json